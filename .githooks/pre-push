#!/usr/bin/env bash

set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "$0")/common.sh"

changed_paths_file="$(mktemp "${TMPDIR:-/tmp}/adless-pre-push.XXXXXX")"
trap 'rm -f "$changed_paths_file"' EXIT

: > "$changed_paths_file"

while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  [ "$local_ref" != "(delete)" ] || continue

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    git ls-tree -r --name-only "$local_sha" >> "$changed_paths_file"
  else
    git diff --name-only "$remote_sha" "$local_sha" >> "$changed_paths_file"
  fi
done

sort -u "$changed_paths_file" -o "$changed_paths_file"

needs_blocklist=false
needs_worker=false
needs_landing=false
needs_ios=false
needs_release=false

while IFS= read -r path; do
  case "$path" in
    .github/workflows/**|tools/appstore/**|tools/ios/**|tools/dns-worker/testflight_builds.py|tools/dns-worker/tests/**|docs/app-store/ExportOptions*.plist|docs/app-store/testflight-notes.txt|.githooks/**)
      needs_release=true
      ;;
  esac

  case "$path" in
    tools/blocklists/**)
      needs_blocklist=true
      ;;
  esac

  case "$path" in
    apps/dns-worker/**|tools/dns-worker/**)
      needs_worker=true
      ;;
    package-lock.json)
      needs_worker=true
      needs_landing=true
      ;;
  esac

  case "$path" in
    apps/landing-page/**|package.json)
      needs_landing=true
      ;;
  esac

  case "$path" in
    apps/ios/**)
      needs_ios=true
      ;;
  esac
done < "$changed_paths_file"

if [ "$needs_release" = true ]; then
  run_release_tests
fi

if [ "$needs_blocklist" = true ]; then
  run_blocklist_tests
fi

if [ "$needs_worker" = true ]; then
  run_worker_checks
fi

if [ "$needs_landing" = true ]; then
  run_landing_checks
fi

if [ "$needs_ios" = true ]; then
  run_ios_tests
fi

if [ "$needs_blocklist" = false ] && [ "$needs_worker" = false ] && \
   [ "$needs_landing" = false ] && [ "$needs_ios" = false ] && [ "$needs_release" = false ]; then
  echo "Adless pre-push: no targeted checks for these paths."
fi

echo "Adless pre-push checks passed."
